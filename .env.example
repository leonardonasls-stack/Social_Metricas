# PostgreSQL Config
POSTGRES_DB=metrica_social
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/metrica_social

# Backend Config
ENVIRONMENT=development
BACKEND_PORT=8000
DEFAULT_MINING_MODE=mock # 'mock' para sandbox/testes, 'live' para mineração real

# ScrapeCreators Engine Config (Obrigatório apenas no modo live)
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# LLM Synthesis Engine (Opcional se usar síntese por heurística/mock)
SYNTHESIS_API_KEY=
SYNTHESIS_MODEL=gpt-4o-mini

# Frontend Config
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
