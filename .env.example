# PostgreSQL Config
POSTGRES_DB=metrica_social
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/metrica_social

# Backend Config
ENVIRONMENT=development
BACKEND_PORT=8000
DEFAULT_MINING_MODE=mock # 'mock' para sandbox/testes, 'live' para mineração real

# ScrapeCreators Engine Config (Opcional em modo mock)
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# -------------------------------------------------------------
# Chaves Multi-LLM para Failover Automático de Tokens (Gratuitas)
# -------------------------------------------------------------
# 1. Google Gemini (Obtenha grátis em: aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud (Obtenha grátis em: console.groq.com - Roda DeepSeek R1 e Llama 3.3)
GROQ_API_KEY=
GROQ_MODEL=deepseek-r1-distill-llama-70b

# 3. OpenRouter (Obtenha grátis em: openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Frontend Config
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
