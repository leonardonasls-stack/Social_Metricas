# PostgreSQL Config
POSTGRES_DB=metrica_social
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/metrica_social

# Backend Config
ENVIRONMENT=development
BACKEND_PORT=8000
DEFAULT_MINING_MODE=mock # 'mock' para sandbox/testes, 'live' para mineração real

# ScrapeCreators Engine Config (Opcional em modo mock)
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# -------------------------------------------------------------
# Chaves Multi-LLM para Failover Automático de Tokens (Gratuitas)
# -------------------------------------------------------------
# 1. Google Gemini (Obtenha grátis em: aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Groq Cloud (Obtenha grátis em: console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3. OpenRouter (Obtenha grátis em: openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Frontend Config
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
